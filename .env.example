# Committed template only. Lovable regenerates a local `.env` — leave that file untracked.
# Frontend (Vite) — publishable values only.
# Never put Stripe secrets, Core API keys, service-role keys, or owner emails here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_USE_MOCK=false

# ── Server-side secrets (Supabase Edge Functions dashboard, not this file) ──
# Billing is active only when ALL THREE of these are set (see billing_active):
#   STRIPE_SECRET_KEY
#   STRIPE_WEBHOOK_SECRET
#   ALLOWED_ORIGINS=https://sottra.app
# Other edge secrets (never VITE_*):
#   CORE_API_URL
#   CORE_API_KEY
#   ADMIN_BOOTSTRAP_EMAILS
#   COMMERCIAL_BYPASS_EMAILS
#   SUPABASE_SERVICE_ROLE_KEY
